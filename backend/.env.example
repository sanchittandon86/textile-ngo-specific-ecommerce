PORT=3000
# Origin allowed by CORS -- the frontend's dev server URL. Required
# (not just recommended) when NODE_ENV=production.
CLIENT_URL=http://localhost:3001
# Set to "production" to enable production-only startup checks
# (CLIENT_URL required, JWT secrets checked for minimum strength).
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=textile_store
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Most managed Postgres providers (Render, Supabase, Railway, RDS)
# require SSL -- set DB_SSL=true when connecting to one of those.
# Leave DB_SSL_REJECT_UNAUTHORIZED unset/false unless you've supplied a
# CA cert Node can validate against (most providers present a cert
# outside Node's default trust store).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Razorpay (test mode keys from the Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Settings -> Webhooks -> (create/edit a webhook) -> Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin auth (JWT) -- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Dashboard -> Settings -> API Keys) -- used by the bulk
# product catalog import to host product images.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email notifications (Resend -- https://resend.com/api-keys). Used for
# ORDER_PLACED/PAYMENT_SUCCESS/ORDER_SHIPPED/ORDER_DELIVERED/refund
# transactional emails. Never exposed to the frontend.
RESEND_API_KEY=re_your_resend_api_key
# Must be on a domain verified in Resend (Resend Dashboard -> Domains).
EMAIL_FROM="Aaranya <orders@your-verified-domain.com>"

# WhatsApp transactional notifications (official Meta WhatsApp Cloud
# API -- https://developers.facebook.com/docs/whatsapp/cloud-api).
# Never exposed to the frontend. See README/setup notes for exactly
# what must be configured in Meta Business Manager before these work.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v21.0

# Approved Meta message template names (Meta Business Manager -> Account
# Tools -> Message Templates). Each must be created and APPROVED before
# that notification type can send over WhatsApp -- see setup notes.
WHATSAPP_TEMPLATE_ORDER_PLACED=order_placed
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS=payment_success
WHATSAPP_TEMPLATE_ORDER_SHIPPED=order_shipped
WHATSAPP_TEMPLATE_ORDER_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_REFUND_INITIATED=refund_initiated
WHATSAPP_TEMPLATE_REFUND_COMPLETED=refund_completed
