PORT=3000
# Origin allowed by CORS -- the frontend's dev server URL
CLIENT_URL=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=textile_store
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Razorpay (test mode keys from the Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Settings -> Webhooks -> (create/edit a webhook) -> Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin auth (JWT) -- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Dashboard -> Settings -> API Keys) -- used by the bulk
# product catalog import to host product images.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
